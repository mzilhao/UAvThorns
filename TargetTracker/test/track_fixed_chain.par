# TargetTracker test: fixed target, chained target, and surface storage
#
# A fixed target 0 stays at its 'initial_*' position; target 1 uses target 0's
# stored location as its source. This exercises the tracker-to-surface path and
# the chaining of trackers without requiring any matter or evolution.

ActiveThorns = "
  ADMBase
  ADMMacros
  Boundary
  Carpet
  CarpetInterp
  CarpetIOASCII
  CarpetIOBasic
  CarpetLib
  CarpetReduce
  CartGrid3D
  CoordBase
  CoordGauge
  Exact
  InitBase
  IOUtil
  LocalInterp
  LoopControl
  MoL
  NewRad
  ReflectionSymmetry
  SpaceMask
  SphericalSurface
  StaticConformal
  SymBase
  TargetTracker
  Time
  TmunuBase
"

# Grid setup
#------------------------------------------------------------------------------

CartGrid3D::type                     = "coordbase"
Carpet::domain_from_coordbase        = yes
CoordBase::domainsize                = "minmax"

CoordBase::xmin                      = -8.0
CoordBase::ymin                      = -8.0
CoordBase::zmin                      = -8.0
CoordBase::xmax                      = +8.0
CoordBase::ymax                      = +8.0
CoordBase::zmax                      = +8.0
CoordBase::dx                        =  1.0
CoordBase::dy                        =  1.0
CoordBase::dz                        =  1.0

driver::ghost_size                   = 3

CoordBase::boundary_size_x_lower     = 3
CoordBase::boundary_size_y_lower     = 3
CoordBase::boundary_size_z_lower     = 3
CoordBase::boundary_size_x_upper     = 3
CoordBase::boundary_size_y_upper     = 3
CoordBase::boundary_size_z_upper     = 3

ReflectionSymmetry::reflection_x     = no
ReflectionSymmetry::reflection_y     = no
ReflectionSymmetry::reflection_z     = no

# Initial data (flat space)
#------------------------------------------------------------------------------

ADMBase::initial_data                 = "exact"
ADMBase::initial_lapse                = "exact"
ADMBase::initial_shift                = "exact"
ADMBase::initial_dtlapse              = "exact"
ADMBase::initial_dtshift              = "exact"

ADMBase::lapse_timelevels             = 3
ADMBase::shift_timelevels             = 3
ADMBase::metric_timelevels            = 3

Exact::exact_model                    = "Minkowski"

InitBase::initial_data_setup_method   = "init_some_levels"
Carpet::init_fill_timelevels          = yes
Carpet::init_3_timelevels             = no

# Evolution (static)
#------------------------------------------------------------------------------

ADMBase::evolution_method             = "static"
ADMBase::lapse_evolution_method       = "static"
ADMBase::shift_evolution_method       = "static"
ADMBase::dtlapse_evolution_method     = "static"
ADMBase::dtshift_evolution_method     = "static"

MoL::ODE_Method                       = "RK4"
MoL::MoL_Intermediate_Steps           = 4
MoL::MoL_Num_Scratch_Levels           = 1

Carpet::num_integrator_substeps       = 4
Time::dtfac                           = 0.25

# Spherical surfaces
#------------------------------------------------------------------------------

SphericalSurface::nsurfaces           = 2
SphericalSurface::maxntheta           = 10
SphericalSurface::maxnphi             = 20
SphericalSurface::verbose             = no

SphericalSurface::ntheta              [0] = 10
SphericalSurface::nphi                [0] = 20
SphericalSurface::nghoststheta        [0] = 2
SphericalSurface::nghostsphi          [0] = 2

SphericalSurface::ntheta              [1] = 10
SphericalSurface::nphi                [1] = 20
SphericalSurface::nghoststheta        [1] = 2
SphericalSurface::nghostsphi          [1] = 2

# Target tracking
#------------------------------------------------------------------------------

# Target 0: fixed at (2,3,4), stored into surface 0
TargetTracker::track                          [0] = yes
TargetTracker::initial_x                      [0] = 2.0
TargetTracker::initial_y                      [0] = 3.0
TargetTracker::initial_z                      [0] = 4.0
TargetTracker::which_surface_to_store_info    [0] = 0

# Target 1: copies target 0's location (chained tracker)
TargetTracker::track                          [1] = yes
TargetTracker::target_x                       [1] = "TargetTracker::target_loc_x[0]"
TargetTracker::target_y                       [1] = "TargetTracker::target_loc_y[0]"
TargetTracker::target_z                       [1] = "TargetTracker::target_loc_z[0]"
TargetTracker::track_every                    [1] = 1

TargetTracker::verbose                             = yes

# Output
#------------------------------------------------------------------------------

Cactus::cctk_run_title       = $parfile
IO::out_dir                  = $parfile
IO::out_fileinfo             = "none"

IOASCII::one_file_per_group  = yes

IOASCII::out0D_every         = 1
IOASCII::out0D_point_x       = 4.0
IOASCII::out0D_point_y       = 4.0
IOASCII::out0D_vars          = "
  TargetTracker::target_loc
  SphericalSurface::sf_info
"

# Run termination
#------------------------------------------------------------------------------

Cactus::terminate            = "iteration"
Cactus::cctk_itlast          = 4
