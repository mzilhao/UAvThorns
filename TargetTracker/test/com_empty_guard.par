# TargetTracker test: an integration region that becomes empty
#
# Target 0 starts with a sphere of radius 3 centered at (1.5,0,0), which
# contains matter, and is then moved (by a trigger) to (100,0,0), where there
# is none. The mass integral then vanishes, so the code must keep the
# previously computed values (which differ from the initial ones) and print a
# warning, instead of dividing by zero or producing NaNs. Target 2 is empty
# from the very first pass, which additionally checks that the initial values
# are kept in that case.

ActiveThorns = "
  ADMBase
  ADMMacros
  Boundary
  Carpet
  CarpetInterp
  CarpetIOASCII
  CarpetIOBasic
  CarpetLib
  CarpetReduce
  CartGrid3D
  CoordBase
  CoordGauge
  Dissipation
  Exact
  GenericFD
  InitBase
  IOUtil
  LocalInterp
  LoopControl
  MoL
  NewRad
  ReflectionSymmetry
  ScalarBase
  ScalarEvolve
  ScalarInit
  Slab
  SpaceMask
  SphericalSurface
  StaticConformal
  SymBase
  TargetTracker
  Time
  Trigger
  TmunuBase
"

# Grid setup
#------------------------------------------------------------------------------

CartGrid3D::type                     = "coordbase"
Carpet::domain_from_coordbase        = yes
CoordBase::domainsize                = "minmax"

CoordBase::xmin                      = -4.0
CoordBase::ymin                      = -4.0
CoordBase::zmin                      = -4.0
CoordBase::xmax                      = +4.0
CoordBase::ymax                      = +4.0
CoordBase::zmax                      = +4.0
CoordBase::dx                        =  1.0
CoordBase::dy                        =  1.0
CoordBase::dz                        =  1.0

driver::ghost_size                   = 3

CoordBase::boundary_size_x_lower     = 3
CoordBase::boundary_size_y_lower     = 3
CoordBase::boundary_size_z_lower     = 3
CoordBase::boundary_size_x_upper     = 3
CoordBase::boundary_size_y_upper     = 3
CoordBase::boundary_size_z_upper     = 3

ReflectionSymmetry::reflection_x     = no
ReflectionSymmetry::reflection_y     = no
ReflectionSymmetry::reflection_z     = no

# Initial data (flat space + constant scalar)
#------------------------------------------------------------------------------

ADMBase::initial_data                 = "exact"
ADMBase::initial_lapse                = "exact"
ADMBase::initial_shift                = "exact"
ADMBase::initial_dtlapse              = "exact"
ADMBase::initial_dtshift              = "exact"

ADMBase::lapse_timelevels             = 3
ADMBase::shift_timelevels             = 3
ADMBase::metric_timelevels            = 3

Exact::exact_model                    = "Minkowski"

ScalarBase::initial_scalar            = "ID_SF_Const"
ScalarBase::mu                        = 1.0
ScalarInit::l0SF                      = 0
ScalarInit::m0SF                      = 0
ScalarInit::ampSF                     = 1.0

InitBase::initial_data_setup_method   = "init_some_levels"
Carpet::init_fill_timelevels          = yes
Carpet::init_3_timelevels             = no

# Evolution
#------------------------------------------------------------------------------

ADMBase::evolution_method             = "static"
ADMBase::lapse_evolution_method       = "static"
ADMBase::shift_evolution_method       = "static"
ADMBase::dtlapse_evolution_method     = "static"
ADMBase::dtshift_evolution_method     = "static"

ScalarBase::evolution_method          = "ScalarEvolve"
ScalarEvolve::chi_floor               = 1.0e-06

TmunuBase::stress_energy_storage      = yes
TmunuBase::stress_energy_at_RHS       = yes
TmunuBase::timelevels                 = 1
TmunuBase::prolongation_type          = "none"

MoL::ODE_Method                       = "RK4"
MoL::MoL_Intermediate_Steps           = 4
MoL::MoL_Num_Scratch_Levels           = 1

Carpet::num_integrator_substeps       = 4
Time::dtfac                           = 0.25

# Spherical surfaces
#------------------------------------------------------------------------------

SphericalSurface::nsurfaces           = 1
SphericalSurface::maxntheta           = 10
SphericalSurface::maxnphi             = 20
SphericalSurface::verbose             = no

SphericalSurface::ntheta              [0] = 10
SphericalSurface::nphi                [0] = 20
SphericalSurface::nghoststheta        [0] = 2
SphericalSurface::nghostsphi          [0] = 2

# Center of mass in an empty region
#------------------------------------------------------------------------------

# Target 0: a sphere of radius 3 centered at (1.5,0,0), i.e. it is cut by the
# x = 4 boundary, so the constant-density matter inside it is *not* symmetric
# about its center: the first computed CoM differs from the initial position
# (1.5,0,0). At t > 0.25 a trigger moves the sphere to (100,0,0), where there
# is no matter; the code must then keep the *previously computed* CoM (not the
# initial one) and warn.
TargetTracker::track                          [0] = yes
TargetTracker::compute_com                    [0] = yes
TargetTracker::initial_x                      [0] = 1.5
TargetTracker::initial_y                      [0] = 0.0
TargetTracker::initial_z                      [0] = 0.0
TargetTracker::com_compute_inside_radius      [0] = 3.0

# Target 1: fixed at (100,0,0), only used as the source for the trigger below.
TargetTracker::track                          [1] = yes
TargetTracker::initial_x                      [1] = 100.0

# Target 2: empty region from the very first pass, so the guard keeps the
# initial value (and a zero mass).
TargetTracker::compute_com                    [2] = yes
TargetTracker::initial_x                      [2] = 100.0
TargetTracker::initial_y                      [2] = 0.0
TargetTracker::initial_z                      [2] = 0.0
TargetTracker::com_compute_inside_radius      [2] = 1.0

TargetTracker::com_symmetry                        = "none"
TargetTracker::verbose                             = yes

# Move the sphere of target 0 into an empty region.
Trigger::Trigger_Number                       = 1
Trigger::Trigger_Checked_Variable         [0] = "Trigger::trigger_cctk_time"
Trigger::Trigger_Reduction                [0] = "minimum"
Trigger::Trigger_Relation                 [0] = ">"
Trigger::Trigger_Checked_Value            [0] = 0.25
Trigger::Trigger_Reaction                 [0] = "steerparam"
Trigger::Trigger_Steered_Parameter_Thorn  [0] = "TargetTracker"
Trigger::Trigger_Steered_Parameter_Name   [0] = "target_x[0]"
Trigger::Trigger_Steered_Parameter_Value  [0] = "TargetTracker::target_loc_x[1]"

# Output
#------------------------------------------------------------------------------

Cactus::cctk_run_title       = $parfile
IO::out_dir                  = $parfile
IO::out_fileinfo             = "none"

IOASCII::one_file_per_group  = yes

IOASCII::out0D_every         = 1
IOASCII::out0D_point_x       = 4.0
IOASCII::out0D_point_y       = 4.0
IOASCII::out0D_vars          = "
  TargetTracker::target_com
"

# Run termination
#------------------------------------------------------------------------------

Cactus::terminate            = "iteration"
Cactus::cctk_itlast          = 4
