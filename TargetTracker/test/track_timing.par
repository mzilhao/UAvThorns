# TargetTracker test: timing controls
#
# Target 0 starts fixed at x = 1 and is moved by triggers to x = 2
# (iteration 1) and x = 3 (iteration 3), so that all the timing controls below
# are checked against a source that actually moves:
#
#   - target 1: start_tracking_after_time (delayed start)
#   - target 2: stop_tracking_after_time  (freezes after t = 0.5)
#   - target 3: track_every = 2           (skips the odd iterations)
#   - target 4: 'track' steered off at runtime
#
# See the comment block in the target section for the expected values.

ActiveThorns = "
  ADMBase
  ADMMacros
  Boundary
  Carpet
  CarpetInterp
  CarpetIOASCII
  CarpetIOBasic
  CarpetLib
  CarpetReduce
  CartGrid3D
  CoordBase
  CoordGauge
  Exact
  InitBase
  IOUtil
  LocalInterp
  LoopControl
  MoL
  NewRad
  ReflectionSymmetry
  SpaceMask
  SphericalSurface
  StaticConformal
  SymBase
  TargetTracker
  Time
  Trigger
  TmunuBase
"

# Grid setup
#------------------------------------------------------------------------------

CartGrid3D::type                     = "coordbase"
Carpet::domain_from_coordbase        = yes
CoordBase::domainsize                = "minmax"

CoordBase::xmin                      = -8.0
CoordBase::ymin                      = -8.0
CoordBase::zmin                      = -8.0
CoordBase::xmax                      = +8.0
CoordBase::ymax                      = +8.0
CoordBase::zmax                      = +8.0
CoordBase::dx                        =  1.0
CoordBase::dy                        =  1.0
CoordBase::dz                        =  1.0

driver::ghost_size                   = 3

CoordBase::boundary_size_x_lower     = 3
CoordBase::boundary_size_y_lower     = 3
CoordBase::boundary_size_z_lower     = 3
CoordBase::boundary_size_x_upper     = 3
CoordBase::boundary_size_y_upper     = 3
CoordBase::boundary_size_z_upper     = 3

ReflectionSymmetry::reflection_x     = no
ReflectionSymmetry::reflection_y     = no
ReflectionSymmetry::reflection_z     = no

# Initial data (flat space)
#------------------------------------------------------------------------------

ADMBase::initial_data                 = "exact"
ADMBase::initial_lapse                = "exact"
ADMBase::initial_shift                = "exact"
ADMBase::initial_dtlapse              = "exact"
ADMBase::initial_dtshift              = "exact"

ADMBase::lapse_timelevels             = 3
ADMBase::shift_timelevels             = 3
ADMBase::metric_timelevels            = 3

Exact::exact_model                    = "Minkowski"

InitBase::initial_data_setup_method   = "init_some_levels"
Carpet::init_fill_timelevels          = yes
Carpet::init_3_timelevels             = no

# Evolution (static)
#------------------------------------------------------------------------------

ADMBase::evolution_method             = "static"
ADMBase::lapse_evolution_method       = "static"
ADMBase::shift_evolution_method       = "static"
ADMBase::dtlapse_evolution_method     = "static"
ADMBase::dtshift_evolution_method     = "static"

MoL::ODE_Method                       = "RK4"
MoL::MoL_Intermediate_Steps           = 4
MoL::MoL_Num_Scratch_Levels           = 1

Carpet::num_integrator_substeps       = 4
Time::dtfac                           = 0.25

# Spherical surfaces
#------------------------------------------------------------------------------

SphericalSurface::nsurfaces           = 1
SphericalSurface::maxntheta           = 10
SphericalSurface::maxnphi             = 20
SphericalSurface::verbose             = no

SphericalSurface::ntheta              [0] = 10
SphericalSurface::nphi                [0] = 20
SphericalSurface::nghoststheta        [0] = 2
SphericalSurface::nghostsphi          [0] = 2

# Target tracking
#------------------------------------------------------------------------------

# Target 0: starts fixed at x = 1, and is then moved by triggers to x = 2
# (t > 0.2, i.e. iteration 1) and to x = 3 (t > 0.6, i.e. iteration 3). The
# updates at *odd* iterations are what makes track_every observable below.
TargetTracker::track                          [0] = yes
TargetTracker::initial_x                      [0] = 1.0
TargetTracker::initial_y                      [0] = 2.0
TargetTracker::initial_z                      [0] = 3.0

# Target 1: delayed start at t >= 0.5 (should be -2 before, then follow x0).
TargetTracker::track                          [1] = yes
TargetTracker::initial_x                      [1] = -2.0
TargetTracker::target_x                       [1] = "TargetTracker::target_loc_x[0]"
TargetTracker::start_tracking_after_time      [1] = 0.5

# Target 2: stops tracking after t > 0.5, so it freezes at the value of x0 at
# that time (2) and does not see the later jump to 3.
TargetTracker::track                          [2] = yes
TargetTracker::initial_x                      [2] = -5.0
TargetTracker::target_x                       [2] = "TargetTracker::target_loc_x[0]"
TargetTracker::stop_tracking_after_time       [2] = 0.5

# Target 3: updated only every 2 iterations, so it lags behind x0 (updated at
# iterations 0, 2 and 4 only, while x0 jumps at iterations 1 and 3).
TargetTracker::track                          [3] = yes
TargetTracker::initial_x                      [3] = -9.0
TargetTracker::target_x                       [3] = "TargetTracker::target_loc_x[0]"
TargetTracker::track_every                    [3] = 2

# Target 4: steered from 'track = yes' to 'track = no' at t > 0.6
# (iteration 3), so it freezes at the value it had at iteration 2 (2).
TargetTracker::track                          [4] = yes
TargetTracker::initial_x                      [4] = -7.0
TargetTracker::target_x                       [4] = "TargetTracker::target_loc_x[0]"

# Target 5: its x source is steered to "" (a fixed target) at t > 0.6
# (iteration 3), so it keeps the location it had at iteration 2 (2).
TargetTracker::track                          [5] = yes
TargetTracker::initial_x                      [5] = -8.0
TargetTracker::target_x                       [5] = "TargetTracker::target_loc_x[0]"

TargetTracker::verbose                             = yes

# Expected target_loc_x per iteration (0..6), with x0 = 1, 2, 2, 3, 3, 3, 3:
#
#   target 0: 1  2  2  3  3  3  3
#   target 1: -2 -2  2  3  3  3  3   (delayed start)
#   target 2: 1  2  2  2  2  2  2   (frozen after t = 0.5)
#   target 3: 1  1  2  2  3  3  3   (track_every = 2)
#   target 4: 1  2  2  2  2  2  2   (track steered off at iteration 3)
#   target 5: 1  2  2  2  2  2  2   (target_x steered to "" at iteration 3)

# Move target 0, and steer targets 4 and 5.
Trigger::Trigger_Number                       = 4

Trigger::Trigger_Checked_Variable         [0] = "Trigger::trigger_cctk_time"
Trigger::Trigger_Reduction                [0] = "minimum"
Trigger::Trigger_Relation                 [0] = ">"
Trigger::Trigger_Checked_Value            [0] = 0.2
Trigger::Trigger_Reaction                 [0] = "steerparam"
Trigger::Trigger_Steered_Parameter_Thorn  [0] = "TargetTracker"
Trigger::Trigger_Steered_Parameter_Name   [0] = "target_x[0]"
Trigger::Trigger_Steered_Parameter_Value  [0] = "TargetTracker::target_loc_y[0]"

Trigger::Trigger_Checked_Variable         [1] = "Trigger::trigger_cctk_time"
Trigger::Trigger_Reduction                [1] = "minimum"
Trigger::Trigger_Relation                 [1] = ">"
Trigger::Trigger_Checked_Value            [1] = 0.6
Trigger::Trigger_Reaction                 [1] = "steerparam"
Trigger::Trigger_Steered_Parameter_Thorn  [1] = "TargetTracker"
Trigger::Trigger_Steered_Parameter_Name   [1] = "target_x[0]"
Trigger::Trigger_Steered_Parameter_Value  [1] = "TargetTracker::target_loc_z[0]"

Trigger::Trigger_Checked_Variable         [2] = "Trigger::trigger_cctk_time"
Trigger::Trigger_Reduction                [2] = "minimum"
Trigger::Trigger_Relation                 [2] = ">"
Trigger::Trigger_Checked_Value            [2] = 0.6
Trigger::Trigger_Reaction                 [2] = "steerparam"
Trigger::Trigger_Steered_Parameter_Thorn  [2] = "TargetTracker"
Trigger::Trigger_Steered_Parameter_Name   [2] = "track[4]"
Trigger::Trigger_Steered_Parameter_Value  [2] = "no"

Trigger::Trigger_Checked_Variable         [3] = "Trigger::trigger_cctk_time"
Trigger::Trigger_Reduction                [3] = "minimum"
Trigger::Trigger_Relation                 [3] = ">"
Trigger::Trigger_Checked_Value            [3] = 0.6
Trigger::Trigger_Reaction                 [3] = "steerparam"
Trigger::Trigger_Steered_Parameter_Thorn  [3] = "TargetTracker"
Trigger::Trigger_Steered_Parameter_Name   [3] = "target_x[5]"
Trigger::Trigger_Steered_Parameter_Value  [3] = ""

# Output
#------------------------------------------------------------------------------

Cactus::cctk_run_title       = $parfile
IO::out_dir                  = $parfile
IO::out_fileinfo             = "none"

IOASCII::one_file_per_group  = yes

IOASCII::out0D_every         = 1
IOASCII::out0D_point_x       = 4.0
IOASCII::out0D_point_y       = 4.0
IOASCII::out0D_vars          = "
  TargetTracker::target_loc
"

# Run termination
#------------------------------------------------------------------------------

Cactus::terminate            = "iteration"
Cactus::cctk_itlast          = 6
