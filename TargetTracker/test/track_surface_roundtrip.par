# TargetTracker test: surface <-> tracker roundtrip
#
# Target 0 stores its location into spherical surface 0 and is moved by a
# trigger from x = 2 to x = 5 (t > 0.25). Target 1 starts in
# 'loc_from_surface_mode', so it reads the (moving) centroid back from surface
# 0. At t > 0.75 a trigger switches that mode off, and target 1 goes back to
# tracking a grid scalar (target 2, fixed at x = 9). This tests both
# directions of the data flow on something that actually moves, and the
# runtime steerability of 'loc_from_surface_mode'.

ActiveThorns = "
  ADMBase
  ADMMacros
  Boundary
  Carpet
  CarpetInterp
  CarpetIOASCII
  CarpetIOBasic
  CarpetLib
  CarpetReduce
  CartGrid3D
  CoordBase
  CoordGauge
  Exact
  InitBase
  IOUtil
  LocalInterp
  LoopControl
  MoL
  NewRad
  ReflectionSymmetry
  SpaceMask
  SphericalSurface
  StaticConformal
  SymBase
  TargetTracker
  Time
  Trigger
  TmunuBase
"

# Grid setup
#------------------------------------------------------------------------------

CartGrid3D::type                     = "coordbase"
Carpet::domain_from_coordbase        = yes
CoordBase::domainsize                = "minmax"

CoordBase::xmin                      = -8.0
CoordBase::ymin                      = -8.0
CoordBase::zmin                      = -8.0
CoordBase::xmax                      = +8.0
CoordBase::ymax                      = +8.0
CoordBase::zmax                      = +8.0
CoordBase::dx                        =  1.0
CoordBase::dy                        =  1.0
CoordBase::dz                        =  1.0

driver::ghost_size                   = 3

CoordBase::boundary_size_x_lower     = 3
CoordBase::boundary_size_y_lower     = 3
CoordBase::boundary_size_z_lower     = 3
CoordBase::boundary_size_x_upper     = 3
CoordBase::boundary_size_y_upper     = 3
CoordBase::boundary_size_z_upper     = 3

ReflectionSymmetry::reflection_x     = no
ReflectionSymmetry::reflection_y     = no
ReflectionSymmetry::reflection_z     = no

# Initial data (flat space)
#------------------------------------------------------------------------------

ADMBase::initial_data                 = "exact"
ADMBase::initial_lapse                = "exact"
ADMBase::initial_shift                = "exact"
ADMBase::initial_dtlapse              = "exact"
ADMBase::initial_dtshift              = "exact"

ADMBase::lapse_timelevels             = 3
ADMBase::shift_timelevels             = 3
ADMBase::metric_timelevels            = 3

Exact::exact_model                    = "Minkowski"

InitBase::initial_data_setup_method   = "init_some_levels"
Carpet::init_fill_timelevels          = yes
Carpet::init_3_timelevels             = no

# Evolution (static)
#------------------------------------------------------------------------------

ADMBase::evolution_method             = "static"
ADMBase::lapse_evolution_method       = "static"
ADMBase::shift_evolution_method       = "static"
ADMBase::dtlapse_evolution_method     = "static"
ADMBase::dtshift_evolution_method     = "static"

MoL::ODE_Method                       = "RK4"
MoL::MoL_Intermediate_Steps           = 4
MoL::MoL_Num_Scratch_Levels           = 1

Carpet::num_integrator_substeps       = 4
Time::dtfac                           = 0.25

# Spherical surfaces
#------------------------------------------------------------------------------

SphericalSurface::nsurfaces           = 1
SphericalSurface::maxntheta           = 10
SphericalSurface::maxnphi             = 20
SphericalSurface::verbose             = no

SphericalSurface::ntheta              [0] = 10
SphericalSurface::nphi                [0] = 20
SphericalSurface::nghoststheta        [0] = 2
SphericalSurface::nghostsphi          [0] = 2

# Target tracking
#------------------------------------------------------------------------------

# Target 0: starts fixed at (2,0,0), stored into surface 0. It is moved to
# x = 5 at t > 0.25 (trigger), so that the surface (and target 1) follow
# something that actually moves.
TargetTracker::track                          [0] = yes
TargetTracker::initial_x                      [0] = 2.0
TargetTracker::initial_y                      [0] = 5.0
TargetTracker::initial_z                      [0] = 0.0
TargetTracker::which_surface_to_store_info    [0] = 0

# Target 1: starts in 'surface to tracker' mode, reading surface 0 (i.e. the
# location of target 0). At t > 0.75 a trigger switches this mode off, so that
# it goes back to tracking a grid scalar (target 2, fixed at x = 9). This
# exercises both directions of the surface <-> tracker data flow.
TargetTracker::track                          [1] = yes
TargetTracker::loc_from_surface_mode          [1] = yes
TargetTracker::which_surface_to_store_info    [1] = 0
TargetTracker::target_x                       [1] = "TargetTracker::target_loc_x[2]"

# Target 2: fixed at (9,0,0), used as the grid scalar tracked by target 1 once
# it leaves the 'surface to tracker' mode.
TargetTracker::track                          [2] = yes
TargetTracker::initial_x                      [2] = 9.0

TargetTracker::verbose                             = yes

# Move target 0, and switch target 1 back to scalar tracking.
Trigger::Trigger_Number                       = 2

Trigger::Trigger_Checked_Variable         [0] = "Trigger::trigger_cctk_time"
Trigger::Trigger_Reduction                [0] = "minimum"
Trigger::Trigger_Relation                 [0] = ">"
Trigger::Trigger_Checked_Value            [0] = 0.25
Trigger::Trigger_Reaction                 [0] = "steerparam"
Trigger::Trigger_Steered_Parameter_Thorn  [0] = "TargetTracker"
Trigger::Trigger_Steered_Parameter_Name   [0] = "target_x[0]"
Trigger::Trigger_Steered_Parameter_Value  [0] = "TargetTracker::target_loc_y[0]"

Trigger::Trigger_Checked_Variable         [1] = "Trigger::trigger_cctk_time"
Trigger::Trigger_Reduction                [1] = "minimum"
Trigger::Trigger_Relation                 [1] = ">"
Trigger::Trigger_Checked_Value            [1] = 0.75
Trigger::Trigger_Reaction                 [1] = "steerparam"
Trigger::Trigger_Steered_Parameter_Thorn  [1] = "TargetTracker"
Trigger::Trigger_Steered_Parameter_Name   [1] = "loc_from_surface_mode[1]"
Trigger::Trigger_Steered_Parameter_Value  [1] = "no"

# Output
#------------------------------------------------------------------------------

Cactus::cctk_run_title       = $parfile
IO::out_dir                  = $parfile
IO::out_fileinfo             = "none"

IOASCII::one_file_per_group  = yes

IOASCII::out0D_every         = 1
IOASCII::out0D_point_x       = 4.0
IOASCII::out0D_point_y       = 4.0
IOASCII::out0D_vars          = "
  TargetTracker::target_loc
  SphericalSurface::sf_info
"

# Run termination
#------------------------------------------------------------------------------

Cactus::terminate            = "iteration"
Cactus::cctk_itlast          = 6
