# TargetTracker test: surface <-> tracker handover
#
# This mimics the formation of a horizon: target 0 first follows a grid scalar
# and stores its location into spherical surface 0. At t > 0.25 a second
# tracker (target 1) is activated and takes over surface 0, while target 0
# switches to 'loc_from_surface_mode' and follows the surface from then on.
# Target 1 is then moved (by a trigger), and target 0 has to follow it. This
# tests both directions of the surface <-> tracker data flow, the runtime
# steerability of 'loc_from_surface_mode' and 'track', and a clean handover
# (no iteration has two trackers writing the same surface).

ActiveThorns = "
  ADMBase
  ADMMacros
  Boundary
  Carpet
  CarpetInterp
  CarpetIOASCII
  CarpetIOBasic
  CarpetLib
  CarpetReduce
  CartGrid3D
  CoordBase
  CoordGauge
  Exact
  InitBase
  IOUtil
  LocalInterp
  LoopControl
  MoL
  NewRad
  ReflectionSymmetry
  SpaceMask
  SphericalSurface
  StaticConformal
  SymBase
  TargetTracker
  Time
  Trigger
  TmunuBase
"

# Grid setup
#------------------------------------------------------------------------------

CartGrid3D::type                     = "coordbase"
Carpet::domain_from_coordbase        = yes
CoordBase::domainsize                = "minmax"

CoordBase::xmin                      = -8.0
CoordBase::ymin                      = -8.0
CoordBase::zmin                      = -8.0
CoordBase::xmax                      = +8.0
CoordBase::ymax                      = +8.0
CoordBase::zmax                      = +8.0
CoordBase::dx                        =  1.0
CoordBase::dy                        =  1.0
CoordBase::dz                        =  1.0

driver::ghost_size                   = 3

CoordBase::boundary_size_x_lower     = 3
CoordBase::boundary_size_y_lower     = 3
CoordBase::boundary_size_z_lower     = 3
CoordBase::boundary_size_x_upper     = 3
CoordBase::boundary_size_y_upper     = 3
CoordBase::boundary_size_z_upper     = 3

ReflectionSymmetry::reflection_x     = no
ReflectionSymmetry::reflection_y     = no
ReflectionSymmetry::reflection_z     = no

# Initial data (flat space)
#------------------------------------------------------------------------------

ADMBase::initial_data                 = "exact"
ADMBase::initial_lapse                = "exact"
ADMBase::initial_shift                = "exact"
ADMBase::initial_dtlapse              = "exact"
ADMBase::initial_dtshift              = "exact"

ADMBase::lapse_timelevels             = 3
ADMBase::shift_timelevels             = 3
ADMBase::metric_timelevels            = 3

Exact::exact_model                    = "Minkowski"

InitBase::initial_data_setup_method   = "init_some_levels"
Carpet::init_fill_timelevels          = yes
Carpet::init_3_timelevels             = no

# Evolution (static)
#------------------------------------------------------------------------------

ADMBase::evolution_method             = "static"
ADMBase::lapse_evolution_method       = "static"
ADMBase::shift_evolution_method       = "static"
ADMBase::dtlapse_evolution_method     = "static"
ADMBase::dtshift_evolution_method     = "static"

MoL::ODE_Method                       = "RK4"
MoL::MoL_Intermediate_Steps           = 4
MoL::MoL_Num_Scratch_Levels           = 1

Carpet::num_integrator_substeps       = 4
Time::dtfac                           = 0.25

# Spherical surfaces
#------------------------------------------------------------------------------

SphericalSurface::nsurfaces           = 1
SphericalSurface::maxntheta           = 10
SphericalSurface::maxnphi             = 20
SphericalSurface::verbose             = no

SphericalSurface::ntheta              [0] = 10
SphericalSurface::nphi                [0] = 20
SphericalSurface::nghoststheta        [0] = 2
SphericalSurface::nghostsphi          [0] = 2

# Target tracking
#------------------------------------------------------------------------------

# Horizon-formation pattern: a tracker first follows a grid scalar (and sets a
# surface), then hands the surface over to a second tracker and switches to
# following that surface instead.
#
# Target 0: fixed at (2,0,0), writes its location into surface 0. At t > 0.25 a
# trigger switches it to 'surface to tracker' mode: it stops writing surface 0
# and follows it from then on.
TargetTracker::track                          [0] = yes
TargetTracker::initial_x                      [0] = 2.0
TargetTracker::initial_y                      [0] = 0.0
TargetTracker::initial_z                      [0] = 0.0
TargetTracker::which_surface_to_store_info    [0] = 0

# Target 1: inactive and parked at (9,0,0) until t > 0.25, when a trigger
# activates it. It then tracks the value carrier target 5 and writes surface 0,
# taking over from target 0.
TargetTracker::track                          [1] = no
TargetTracker::initial_x                      [1] = 9.0
TargetTracker::initial_y                      [1] = 0.0
TargetTracker::initial_z                      [1] = 0.0
TargetTracker::target_x                       [1] = "TargetTracker::target_loc_x[5]"
TargetTracker::target_y                       [1] = "TargetTracker::target_loc_y[5]"
TargetTracker::target_z                       [1] = "TargetTracker::target_loc_z[5]"
TargetTracker::which_surface_to_store_info    [1] = 0

# Target 5: untracked value carrier, driven by the triggers below.
TargetTracker::track                          [5] = no
TargetTracker::initial_x                      [5] = 5.0
TargetTracker::initial_y                      [5] = 0.0
TargetTracker::initial_z                      [5] = 0.0

TargetTracker::verbose                             = yes

Trigger::Trigger_Number                       = 3

# Hand the surface over: target 0 switches to following surface 0, and target
# 1 starts writing it in the same pass (no iteration with two writers).
Trigger::Trigger_Checked_Variable         [0] = "Trigger::trigger_cctk_time"
Trigger::Trigger_Relation                 [0] = ">"
Trigger::Trigger_Checked_Value            [0] = 0.25
Trigger::Trigger_Reaction                 [0] = "steerparam"
Trigger::Trigger_Steered_Parameter_Thorn  [0] = "TargetTracker"
Trigger::Trigger_Steered_Parameter_Name   [0] = "loc_from_surface_mode[0]"
Trigger::Trigger_Steered_Parameter_Value  [0] = "yes"

Trigger::Trigger_Checked_Variable         [1] = "Trigger::trigger_cctk_time"
Trigger::Trigger_Relation                 [1] = ">"
Trigger::Trigger_Checked_Value            [1] = 0.25
Trigger::Trigger_Reaction                 [1] = "steerparam"
Trigger::Trigger_Steered_Parameter_Thorn  [1] = "TargetTracker"
Trigger::Trigger_Steered_Parameter_Name   [1] = "track[1]"
Trigger::Trigger_Steered_Parameter_Value  [1] = "yes"

# Move the new surface owner, so that target 0 has to follow it.
Trigger::Trigger_Checked_Variable         [2] = "Trigger::trigger_cctk_time"
Trigger::Trigger_Relation                 [2] = ">"
Trigger::Trigger_Checked_Value            [2] = 0.75
Trigger::Trigger_Reaction                 [2] = "steerscalar"
Trigger::Trigger_Steered_Scalar           [2] = "TargetTracker::target_loc_x[5]"
Trigger::Trigger_Steered_Scalar_Index     [2] = 0
Trigger::Trigger_Steered_Scalar_Value     [2] = "7"

# Output
#------------------------------------------------------------------------------

Cactus::cctk_run_title       = $parfile
IO::out_dir                  = $parfile
IO::out_fileinfo             = "none"

IOASCII::one_file_per_group  = yes

IOASCII::out0D_every         = 1
IOASCII::out0D_point_x       = 4.0
IOASCII::out0D_point_y       = 4.0
IOASCII::out0D_vars          = "
  TargetTracker::target_loc
  SphericalSurface::sf_info
"

# Run termination
#------------------------------------------------------------------------------

Cactus::terminate            = "iteration"
Cactus::cctk_itlast          = 6
