# TargetTracker test: self-tracking of a restricted center of mass
#
# The same constant scalar field as in com_empty_guard is used (flat space,
# uniform density). A single tracker computes the center of mass inside a
# sphere of radius 3, and then tracks that center of mass (one-pass feedback):
# the restriction window follows the computed CoM. Since the initial window at
# (1.5,0,0) is cut by the x = 4 boundary, the CoM differs from the window
# center, so the iteration actually moves and converges (towards the origin),
# exercising the feedback loop, the one-pass lag and the add-back of the
# window center.

ActiveThorns = "
  ADMBase
  ADMMacros
  Boundary
  Carpet
  CarpetInterp
  CarpetIOASCII
  CarpetIOBasic
  CarpetLib
  CarpetReduce
  CartGrid3D
  CoordBase
  CoordGauge
  Dissipation
  Exact
  GenericFD
  InitBase
  IOUtil
  LocalInterp
  LoopControl
  MoL
  NewRad
  ReflectionSymmetry
  ScalarBase
  ScalarEvolve
  ScalarInit
  Slab
  SpaceMask
  SphericalSurface
  StaticConformal
  SymBase
  TargetTracker
  Time
  TmunuBase
"

# Grid setup
#------------------------------------------------------------------------------

CartGrid3D::type                     = "coordbase"
Carpet::domain_from_coordbase        = yes
CoordBase::domainsize                = "minmax"

CoordBase::xmin                      = -4.0
CoordBase::ymin                      = -4.0
CoordBase::zmin                      = -4.0
CoordBase::xmax                      = +4.0
CoordBase::ymax                      = +4.0
CoordBase::zmax                      = +4.0
CoordBase::dx                        =  1.0
CoordBase::dy                        =  1.0
CoordBase::dz                        =  1.0

driver::ghost_size                   = 3

CoordBase::boundary_size_x_lower     = 3
CoordBase::boundary_size_y_lower     = 3
CoordBase::boundary_size_z_lower     = 3
CoordBase::boundary_size_x_upper     = 3
CoordBase::boundary_size_y_upper     = 3
CoordBase::boundary_size_z_upper     = 3

ReflectionSymmetry::reflection_x     = no
ReflectionSymmetry::reflection_y     = no
ReflectionSymmetry::reflection_z     = no

# Initial data (flat space + constant scalar)
#------------------------------------------------------------------------------

ADMBase::initial_data                 = "exact"
ADMBase::initial_lapse                = "exact"
ADMBase::initial_shift                = "exact"
ADMBase::initial_dtlapse              = "exact"
ADMBase::initial_dtshift              = "exact"

ADMBase::lapse_timelevels             = 3
ADMBase::shift_timelevels             = 3
ADMBase::metric_timelevels            = 3

Exact::exact_model                    = "Minkowski"

ScalarBase::initial_scalar            = "ID_SF_Const"
ScalarBase::mu                        = 1.0
ScalarInit::l0SF                      = 0
ScalarInit::m0SF                      = 0
ScalarInit::ampSF                     = 1.0

InitBase::initial_data_setup_method   = "init_some_levels"
Carpet::init_fill_timelevels          = yes
Carpet::init_3_timelevels             = no

# Evolution
#------------------------------------------------------------------------------

ADMBase::evolution_method             = "static"
ADMBase::lapse_evolution_method       = "static"
ADMBase::shift_evolution_method       = "static"
ADMBase::dtlapse_evolution_method     = "static"
ADMBase::dtshift_evolution_method     = "static"

ScalarBase::evolution_method          = "ScalarEvolve"
ScalarEvolve::chi_floor               = 1.0e-06

TmunuBase::stress_energy_storage      = yes
TmunuBase::stress_energy_at_RHS       = yes
TmunuBase::timelevels                 = 1
TmunuBase::prolongation_type          = "none"

MoL::ODE_Method                       = "RK4"
MoL::MoL_Intermediate_Steps           = 4
MoL::MoL_Num_Scratch_Levels           = 1

Carpet::num_integrator_substeps       = 4
Time::dtfac                           = 0.25

# Spherical surfaces
#------------------------------------------------------------------------------

SphericalSurface::nsurfaces           = 1
SphericalSurface::maxntheta           = 10
SphericalSurface::maxnphi             = 20
SphericalSurface::verbose             = no

SphericalSurface::ntheta              [0] = 10
SphericalSurface::nphi                [0] = 20
SphericalSurface::nghoststheta        [0] = 2
SphericalSurface::nghostsphi          [0] = 2

# Self-tracked, restricted center of mass
#------------------------------------------------------------------------------

TargetTracker::track                          [0] = yes
TargetTracker::compute_com                    [0] = yes
TargetTracker::initial_x                      [0] = 1.5
TargetTracker::initial_y                      [0] = 0.0
TargetTracker::initial_z                      [0] = 0.0
TargetTracker::com_compute_inside_radius      [0] = 3.0

# Track the computed center of mass itself.
TargetTracker::target_x                       [0] = "TargetTracker::target_com_x[0]"
TargetTracker::target_y                       [0] = "TargetTracker::target_com_y[0]"
TargetTracker::target_z                       [0] = "TargetTracker::target_com_z[0]"

TargetTracker::com_symmetry                        = "none"
TargetTracker::verbose                             = yes

# Output
#------------------------------------------------------------------------------

Cactus::cctk_run_title       = $parfile
IO::out_dir                  = $parfile
IO::out_fileinfo             = "none"

IOASCII::one_file_per_group  = yes

IOASCII::out0D_every         = 1
IOASCII::out0D_point_x       = 4.0
IOASCII::out0D_point_y       = 4.0
IOASCII::out0D_vars          = "
  TargetTracker::target_loc
  TargetTracker::target_com
"

# Run termination
#------------------------------------------------------------------------------

Cactus::terminate            = "iteration"
Cactus::cctk_itlast          = 12
