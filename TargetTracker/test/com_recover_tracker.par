# TargetTracker test: continuation after checkpoint recovery
#
# This test recovers from a checkpoint (shipped as test/com_recover_tracker.tar.gz)
# and checks that the trackers continue correctly, and that
# force_params_at_recovery re-initializes a target from the parameter file.
#
# Target 1 follows the value carrier target 0, which keeps being moved after
# the checkpoint. Target 2 is recovered but explicitly re-initialized from
# this parameter file (track = no, initial_x = -9), so it must stop following
# and sit at -9, while target 1 continues to follow the carrier.
#
# Carpet::max_timelevels is set explicitly: with its automatic value (one more
# than prolongation_order_time, whose default is 1) recovery aborts in
# CarpetIOHDF5 because some groups use 3 time levels (see the README).
#
# NOTE: the committed checkpoint is not portable across changes of the set of
# checkpointed variables. If such variables are added to or removed from the
# thorns used here (including TargetTracker), regenerate the tarball:
# test/com_recover_tracker.tar.gz.

ActiveThorns = "
  ADMBase
  ADMMacros
  Boundary
  Carpet
  CarpetInterp
  CarpetIOASCII
  CarpetIOBasic
  CarpetIOHDF5
  CarpetLib
  CarpetReduce
  CartGrid3D
  CoordBase
  CoordGauge
  Exact
  InitBase
  IOUtil
  LocalInterp
  LoopControl
  MoL
  NewRad
  ReflectionSymmetry
  SpaceMask
  SphericalSurface
  StaticConformal
  SymBase
  TargetTracker
  Time
  Trigger
  TmunuBase
"

# Grid setup
#------------------------------------------------------------------------------

CartGrid3D::type                     = "coordbase"
Carpet::domain_from_coordbase        = yes
CoordBase::domainsize                = "minmax"

CoordBase::xmin                      = -4.0
CoordBase::ymin                      = -4.0
CoordBase::zmin                      = -4.0
CoordBase::xmax                      = +4.0
CoordBase::ymax                      = +4.0
CoordBase::zmax                      = +4.0
CoordBase::dx                        =  1.0
CoordBase::dy                        =  1.0
CoordBase::dz                        =  1.0

driver::ghost_size                   = 3

CoordBase::boundary_size_x_lower     = 3
CoordBase::boundary_size_y_lower     = 3
CoordBase::boundary_size_z_lower     = 3
CoordBase::boundary_size_x_upper     = 3
CoordBase::boundary_size_y_upper     = 3
CoordBase::boundary_size_z_upper     = 3

ReflectionSymmetry::reflection_x     = no
ReflectionSymmetry::reflection_y     = no
ReflectionSymmetry::reflection_z     = no

# Initial data (flat space)
#------------------------------------------------------------------------------

ADMBase::initial_data                 = "exact"
ADMBase::initial_lapse                = "exact"
ADMBase::initial_shift                = "exact"
ADMBase::initial_dtlapse              = "exact"
ADMBase::initial_dtshift              = "exact"

ADMBase::lapse_timelevels             = 3
ADMBase::shift_timelevels             = 3
ADMBase::metric_timelevels            = 3

Exact::exact_model                    = "Minkowski"

InitBase::initial_data_setup_method   = "init_some_levels"
Carpet::init_fill_timelevels          = yes
Carpet::init_3_timelevels             = no

# Evolution (static)
#------------------------------------------------------------------------------

ADMBase::evolution_method             = "static"
ADMBase::lapse_evolution_method       = "static"
ADMBase::shift_evolution_method       = "static"
ADMBase::dtlapse_evolution_method     = "static"
ADMBase::dtshift_evolution_method     = "static"

MoL::ODE_Method                       = "RK4"
MoL::MoL_Intermediate_Steps           = 4
MoL::MoL_Num_Scratch_Levels           = 1

Carpet::num_integrator_substeps       = 4
Time::dtfac                           = 0.25

# Spherical surfaces
#------------------------------------------------------------------------------

SphericalSurface::nsurfaces           = 1
SphericalSurface::maxntheta           = 10
SphericalSurface::maxnphi             = 20
SphericalSurface::verbose             = no

SphericalSurface::ntheta              [0] = 10
SphericalSurface::nphi                [0] = 20
SphericalSurface::nghoststheta        [0] = 2
SphericalSurface::nghostsphi          [0] = 2

# Target tracking
#------------------------------------------------------------------------------

# Target 0: untracked value carrier, moved by the triggers below (1, 2, 3, 4).
TargetTracker::track                          [0] = no
TargetTracker::initial_x                      [0] = 1.0

# Target 1: follows the carrier; must continue to do so after recovery.
TargetTracker::track                          [1] = yes
TargetTracker::initial_x                      [1] = -2.0
TargetTracker::target_x                       [1] = "TargetTracker::target_loc_x[0]"

# Target 2: would also follow the carrier, but is re-initialized from this
# parameter file at recovery (track = no, fixed at -9).
TargetTracker::track                          [2] = no
TargetTracker::initial_x                      [2] = -9.0
TargetTracker::force_params_at_recovery       [2] = yes
TargetTracker::target_x                       [2] = "TargetTracker::target_loc_x[0]"

TargetTracker::verbose                             = yes

# Move the carrier: 1 -> 2 (iteration 2), 3 (iteration 4), 4 (iteration 6).
Trigger::Trigger_Number                       = 3

Trigger::Trigger_Checked_Variable         [0] = "Trigger::trigger_cctk_time"
Trigger::Trigger_Relation                 [0] = ">"
Trigger::Trigger_Checked_Value            [0] = 0.25
Trigger::Trigger_Reaction                 [0] = "steerscalar"
Trigger::Trigger_Steered_Scalar           [0] = "TargetTracker::target_loc_x[0]"
Trigger::Trigger_Steered_Scalar_Index     [0] = 0
Trigger::Trigger_Steered_Scalar_Value     [0] = "2"

Trigger::Trigger_Checked_Variable         [1] = "Trigger::trigger_cctk_time"
Trigger::Trigger_Relation                 [1] = ">"
Trigger::Trigger_Checked_Value            [1] = 0.75
Trigger::Trigger_Reaction                 [1] = "steerscalar"
Trigger::Trigger_Steered_Scalar           [1] = "TargetTracker::target_loc_x[0]"
Trigger::Trigger_Steered_Scalar_Index     [1] = 0
Trigger::Trigger_Steered_Scalar_Value     [1] = "3"

Trigger::Trigger_Checked_Variable         [2] = "Trigger::trigger_cctk_time"
Trigger::Trigger_Relation                 [2] = ">"
Trigger::Trigger_Checked_Value            [2] = 1.25
Trigger::Trigger_Reaction                 [2] = "steerscalar"
Trigger::Trigger_Steered_Scalar           [2] = "TargetTracker::target_loc_x[0]"
Trigger::Trigger_Steered_Scalar_Index     [2] = 0
Trigger::Trigger_Steered_Scalar_Value     [2] = "4"

# Output
#------------------------------------------------------------------------------

Cactus::cctk_run_title       = $parfile
Carpet::max_timelevels       = 3
IO::recover                  = "autoprobe"
IO::recover_dir              = "com_recover_tracker.orig"
IO::checkpoint_on_terminate  = no
IO::out_dir                  = $parfile
IO::out_fileinfo             = "none"

IOASCII::one_file_per_group  = yes

IOASCII::out0D_every         = 1
IOASCII::out0D_point_x       = 4.0
IOASCII::out0D_point_y       = 4.0
IOASCII::out0D_vars          = "
  TargetTracker::target_loc
"

# Run termination
#------------------------------------------------------------------------------

Cactus::terminate            = "iteration"
Cactus::cctk_itlast          = 7
