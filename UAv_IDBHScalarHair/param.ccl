# Parameter definitions for thorn UAv_IDBHScalarHair

SHARES: ScalarBase
USES CCTK_REAL mu

SHARES: ADMBase

EXTENDS KEYWORD initial_data
{
  "Kerr_test" :: "test with Kerr data"
  "HairyBH"   :: "HairyBH initial data"
  "ScalarBS"  :: "Scalar boson star initial data"
}

EXTENDS KEYWORD initial_lapse
{
  "Kerr_test" :: "test with Kerr data"
  "HairyBH"   :: "HairyBH initial lapse profile"
  "ScalarBS"  :: "Scalar boson star initial lapse profile"
  "psi^n"     :: "psi^n initial lapse profile"
}

EXTENDS KEYWORD initial_shift
{
  "Kerr_test" :: "test with Kerr data"
  "HairyBH"   :: "HairyBH initial shift profile"
  "ScalarBS"  :: "Scalar boson star initial shift profile"
}


PRIVATE:

# These parameters shouldn't be used anyway after initial data has been read/generated, so don't need to be STEERABLE.
# However, for convenience, we make the input file STEERABLE because it allows the use of aliases like $ENV{HOME} while
# still allowing a restart from checkpoint on a different machine.

STRING infilename "file to read the input data from" STEERABLE=RECOVER
{
  ".*"  ::  "any valid file name"
} ""

REAL C0 "parameter for R to X coordinate transformation"
{
  (0:* :: "greater than zero"
} 1.0

INT Wbar_r_power "power p in Wbar = r^p * W. For now, p=0,1,2 to make sense with asymptotic behavior. Default is p==2, mostly used in HairyBH initial data."
{
  0:2 :: "0, 1 or 2"
} 2 

INT mm "azimuthal number of the solution. mm=0 for solutions with spherical symmetry, and mm=1,2,3 for current rotating solutions"
{
  0:3 :: "0, 1, 2 or 3"
} 0

# Symmetry of the scalar field, with respect to the equatorial plane (initial data is provided for 0 <= theta <= pi/2).
# With Phi = phi exp{i(m varphi - w t)}, phi z-even is the default.
BOOLEAN phi_z_sym_is_odd "Parity of the scalar field with respect to equatorial (z-)plane symmetry."
{
} "no"

INT maxNF "maximum number of lines allowed in the input file"
{
 100:* :: "any large enough integer"
} 100000


REAL rH "Horizon radius parameter. Incompatible with the Scalar Boson Star."
{
  0:* :: "non-negative"
} 0.0

REAL OmegaH "Horizon angular velocity. Incompatible with the Scalar Boson Star."
{
  0:* :: "non-negative"
} 0.0

REAL omega_BS "Scalar field angular frequency for the Boson Star. Incompatible with the Hairy Black Hole."
{
  0:* :: "non-negative"
} 0.0

REAL ct "ct parameter used for Kerr_test data"
{
  *:0 :: "negative"
} -1.0


REAL x0 "x coordinate of central point"
{
  *:* :: "any real number"
} 0.0

REAL y0 "y coordinate of central point"
{
  *:* :: "any real number"
} 0.0

REAL z0 "z coordinate of central point"
{
  *:* :: "any real number"
} 0.0

CCTK_REAL eps_R "floor value for RR (not used for ScalarBS)."
{
  0:*  :: "any small positive value"
} 1.0d-12


REAL initial_lapse_psi_exponent "Exponent n for psi^n initial lapse profile"
{
  (*:*) :: "Should be negative"
} -2.0

INT normalization_Tmunu "Normalization used for the stress-energy tensor in the input files"
{
  0   :: "4 pi G = 1"
  1   :: "G = 1"
  2   :: "G = 1 and Tmunu has factor of 0.5"
} 0

################################################################################
############### Parameters for perturbations of the initial data ###############
################################################################################
# These parameters allow to add a perturbation to a quantity in the initial data,
# such as the scalar field profile Phi or the conformal factor psi^4 used in the
# 3-metric.
# Note that the derivatives of the perturbation are not taken into account for
# the scalar field momentum K_Phi and the extrinsic curvature K_ij.
# 
# There are currently three types of perturbations delta available:
# relative (1+delta)*Phi, multiplicative delta*Phi, and additive Phi+delta.
#
# The perturbation delta is the product of a radial seed and an angular part.
# Currently, the angular part is simply of the form:
# (rho*mu)^m * cos(m*phi),        with rho^2 = x^2 + y^2,
# where m is a perturbation parameter (need not be the same as the solution's mm).
# CAUTION: This has a dependence on the CYLINDRICAL radius (except for m=0)!
#
# The perturbation is otherwise conceived in terms of the grid coordinates and
# functions, so you may need to add factors of mu, depending on your needs. 
################################################################################

KEYWORD perturbation_field "Field on which to apply the perturbation."
{
  "none" :: "No perturbation"
  "scalar_field" :: "Perturbation to the complex scalar field Phi"
  "conformal_factor" :: "Perturbation to the conformal factor psi^4"
} "none"

# The none-none combination is redundant, but it forces the user to be explicit.
KEYWORD perturbation_type "Type of perturbation to be applied."
{
  "none" :: "No perturbation"
  "relative" :: "Relative perturbation: f * (1 + delta)"
  "multiplicative" :: "Multiplicative perturbation: f * delta"
  "additive" :: "Additive perturbation: f + delta"
} "none"

KEYWORD perturbation_radial_seed "Radial seed for the perturbation to be applied."
{
  "constant" :: "Constant perturbation: delta = A"
  "gaussian" :: "Gaussian perturbation: delta = A * exp[-(R-R0)^2 / (2*width^2)]"
} "constant"

INT perturbation_azimuthal_number "Azimuthal number m for the perturbation to be applied (need not coincide with the solution's mm)."
{
  0   :: "Spherically symmetric perturbation"
  1:* :: "Azimuthal perturbation delta = rho^m * cos(m*phi), with rho^2 = x^2 + y^2"
} 0

REAL perturbation_amplitude "Amplitude for the perturbation to be applied."
{
  *:* :: "any real number"
} 0.0

REAL perturbation_R0 "Center radius for the perturbation to be applied. To be conceived in quasi-isotropic coordinate R."
{
  0:* :: "non-negative"
} 0.0

REAL perturbation_width "Spread for the perturbation to be applied. To be conceived in quasi-isotropic coordinate R."
{
  (0:* :: "positive"
} 1.0
